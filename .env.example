# Environment Configuration Template for Text-to-SQL & Document Chat Platform
# Copy this file to .env and replace placeholder values with your environment settings.
# WARNING: NEVER COMMIT REAL SECRETS OR CREDENTIALS TO VERSION CONTROL.

# Application Configuration
APP_NAME="Text-to-SQL & Document Chat Platform"
APP_ENVIRONMENT="development"  # Options: development, staging, production, test
API_PREFIX="/api"

# PostgreSQL Container Credentials (used by Docker Compose)
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="platform_db"

# Application PostgreSQL Database (Platform Storage)
APPLICATION_DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:5432/platform_db"

# Redis Configuration (Auth Tokens, Rate Limiting, Celery Broker)
REDIS_URL="redis://localhost:6379/0"

# Qdrant Vector Store Configuration
QDRANT_URL="http://localhost:6333"
QDRANT_API_KEY=""  # Optional API key for Qdrant Cloud

# MinIO / Object Storage Configuration
STORAGE_DIR="./storage"
MINIO_ENDPOINT="localhost:9000"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_BUCKET_NAME="tenant-documents"
MINIO_SECURE="false"

# Grafana Configuration
GRAFANA_ADMIN_USER="admin"
GRAFANA_ADMIN_PASSWORD="admin"

# Security & Master Secret Encryption (Must be 32 URL-safe base64-encoded bytes)
JWT_SECRET_KEY="REPLACE_WITH_A_LONG_RANDOM_JWT_SECRET"
ENCRYPTION_MASTER_KEY="REPLACE_WITH_A_VALID_FERNET_KEY"

# Celery & Source Policy
CELERY_TASK_IGNORE_RESULT=true
SOURCE_ALLOWED_DIALECTS=postgresql

# Text-to-SQL Engine Resource & Security Bounds
QUERY_ROW_LIMIT=1000
QUERY_TIMEOUT_SECONDS=30
EMBEDDING_DIMENSIONS=1024
