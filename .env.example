# Copy to .env and replace every REPLACE_* value before starting non-test services.
# This file deliberately contains no usable credentials, keys, source-database values,
# or customer data.
APP_ENV=development
APP_NAME=Text-to-SQL Platform
APP_VERSION=0.1.0
API_PREFIX=/api
DEBUG=false
LOG_LEVEL=INFO
REQUEST_ID_HEADER=X-Request-ID
TRUSTED_HOSTS=localhost,127.0.0.1
CORS_ORIGINS=

# Application PostgreSQL only. This is never a customer source database.
POSTGRES_USER=platform
POSTGRES_PASSWORD=REPLACE_WITH_A_LOCAL_POSTGRES_PASSWORD
POSTGRES_DB=text_to_sql_platform
PLATFORM_DATABASE_URL=postgresql+psycopg://platform:REPLACE_WITH_A_LOCAL_POSTGRES_PASSWORD@postgres:5432/text_to_sql_platform

# Redis is broker/cache infrastructure only; Celery result persistence is disabled.
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_TASK_IGNORE_RESULT=true

# Qdrant is the canonical document retrieval index.
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=document_chunks
QDRANT_TIMEOUT_SECONDS=10
EMBEDDING_DIMENSIONS=1024

# MinIO holds tenant-qualified uploaded file/artifact objects.
MINIO_ENDPOINT=minio:9000
MINIO_SECURE=false
MINIO_BUCKET=tenant-documents
MINIO_ACCESS_KEY=REPLACE_WITH_A_LOCAL_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=REPLACE_WITH_A_LOCAL_MINIO_SECRET_KEY

# Generate unique local values; never commit them.
JWT_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_JWT_SECRET
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7
CONNECTION_ENCRYPTION_KEY=REPLACE_WITH_A_VALID_FERNET_KEY

# Provider configuration is intentionally unconfigured until later phases.
LLM_PROVIDER=unconfigured
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=60
EMBEDDING_PROVIDER=unconfigured
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
EMBEDDING_BATCH_SIZE=32

# SQL/data-residency guardrails.
SOURCE_ALLOWED_DIALECTS=postgresql
SOURCE_EXECUTION_TIMEOUT_SECONDS=30
SOURCE_QUERY_ROW_LIMIT=1000
SOURCE_RESULT_SIZE_LIMIT_BYTES=1000000
METADATA_SAMPLE_VALUE_LIMIT=0
QUERY_PREVIEW_ROW_LIMIT=0
QUERY_PREVIEW_RETENTION_DAYS=0
UPLOAD_SIZE_LIMIT_BYTES=25000000
PARSER_TIMEOUT_SECONDS=120

# Observability and local-only service ports.
PROMETHEUS_MULTIPROC_DIR=
OTEL_EXPORTER_OTLP_ENDPOINT=
API_PORT=8000
MINIO_CONSOLE_PORT=9001
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_A_LOCAL_GRAFANA_PASSWORD
